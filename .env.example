# Service config: copy to /etc/nzbget-dupe-proxy.env (mode 600, owner root). Never commit real values.
LISTEN_PORT=6790
NZBGET_URL=http://127.0.0.1:6789
HYDRA_URL=http://127.0.0.1:5076
HYDRA_APIKEY=
# 0 or -1 = unlimited (every verified, live posting); N = at most N donors (and at most 3N NZB fetches)
MAX_DONORS=0
# 0 = size is not a filter (default; reposts can differ by GBs). e.g. 0.2 = skip results more than 20% off
SIZE_TOLERANCE=0
STATE_DIR=/var/lib/nzbget-dupe-proxy
# donor health: STAT this % of each NZB's articles (min 20, max 300) on every active nzbget news server; 0 = off
HEALTH_PERCENT=2
# drop a donor if less than this share of its sampled articles exists on any server
DONOR_MIN_ALIVE=0.5
# connections per news server used by the health check (also capped at half of nzbget's Connections)
HEALTH_CONNECTIONS=8
# seconds per health pass (quick probe of all donors / full sample of one donor); unanswered = unknown, donor kept
HEALTH_BUDGET=120
# donors appended right after the quick probe; the rest are added one by one after a full sample
FAST_DONORS=5
# false = pure pass-through (kill switch)
ENABLED=true
# 1 = discover donors and log them, but do not append them
DRY_RUN=0

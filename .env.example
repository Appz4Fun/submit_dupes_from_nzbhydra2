# Copy to .env (local tools) or /etc/nzbget-dupe-proxy.env (service, mode 600 root). Never commit real values.
LISTEN_PORT=6790
NZBGET_URL=http://127.0.0.1:6789
NZBGET_USER=
NZBGET_PASS=
HYDRA_URL=http://127.0.0.1:5076
HYDRA_APIKEY=
MAX_DONORS=8
SIZE_TOLERANCE=0.02
STATE_DIR=/var/lib/nzbget-dupe-proxy
ENABLED=true
DRY_RUN=0

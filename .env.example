# Service config: copy to /etc/nzbget-dupe-proxy.env (mode 600, owner root). Never commit real values.
LISTEN_PORT=6790
NZBGET_URL=http://127.0.0.1:6789
HYDRA_URL=http://127.0.0.1:5076
HYDRA_APIKEY=
# 0 or -1 = unlimited (every verified, live posting); N = at most N donors (and at most 3N NZB fetches)
MAX_DONORS=0
# 0 = size is not a filter (default; reposts can differ by GBs). e.g. 0.2 = skip results more than 20% off
SIZE_TOLERANCE=0
STATE_DIR=/var/lib/nzbget-dupe-proxy
# donor health: STAT this % of each NZB's articles on every active nzbget news server; 0 = off
HEALTH_PERCENT=5
# ... but at least / at most this many articles per NZB
HEALTH_MIN_ARTICLES=50
HEALTH_MAX_ARTICLES=1000
# drop a donor if less than this share of its sampled articles exists on any server
DONOR_MIN_ALIVE=0.5
# parallel article check: NZBs checked at once, connections per server per NZB, hard cap per server
# (the cap is also limited to half of each server's own nzbget Connections, so nzbget keeps the rest)
NZBS_TO_CHECK_CONCURRENTLY=10
NNTP_SERVER_CONNECTION_PER_NZB=1
MAX_CONNS_PER_NNTP_SERVER=20
# share of sampled articles that also get BODY + yEnc validation (downloaded from one server), at most N per NZB
BODY_PERCENT=20
BODY_MAX_PER_NZB=20
# seconds per health pass (quick probe of all donors / full sample of up to 4 donors); unanswered = unknown, donor kept
HEALTH_BUDGET=120
# donors appended right after the quick probe; the rest are added one by one after a full sample
FAST_DONORS=5
# false = pure pass-through (kill switch)
ENABLED=true
# 1 = discover donors and log them, but do not append them
DRY_RUN=0
# watch nzbget's queue: picks added without the proxy (nzbdavkodi, uploads) get donors too; needs the nzbget login
WATCH_NZBGET=0
WATCH_INTERVAL=15
WATCH_SETTLE=20
NZBGET_USERNAME=
NZBGET_PASSWORD=
